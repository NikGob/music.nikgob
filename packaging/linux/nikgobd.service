[Unit]
Description=nikgobd, the music.nikgob player without a window
After=pulseaudio.service
Wants=pulseaudio.service

[Service]
Type=simple
ExecStart=%h/.local/bin/nikgobd
Restart=always
RestartSec=3
# SIGTERM: the session and the prefs are saved before it exits.
TimeoutStopSec=20
# Environment=NIKGOBD_LOG=debug

[Install]
WantedBy=default.target
